---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ivct-config
  #namespace: default
data: 
  TESTVARIABLE: {{ .Values.TESTVARIABLE }}
  ACTIVEMQ_HOST: {{ .Values.ACTIVEMQ_HOST }} 
  ACTIVEMQ_PORT: "{{ .Values.ACTIVEMQ_PORT }}"
  IVCT_HOME: {{ .Values.IVCT_HOME }} 
  IVCT_CONF: {{ .Values.IVCT_CONF }}
  NFS_SERVER: {{ .Values.NFS_SERVER }}
  NFS_PATH: {{ .Values.NFS_PATH }}
  NFS_OPTIONS: {{ .Values.NFS_Options }}
  
  PRTI1516E_HOME: {{ .Values.PRTI1516E_HOME }}
  LRC_HOME: {{ .Values.LRC_HOME }}
  LRC_CLASSPATH: {{ .Values.LRC_CLASSPATH }}

  TESTENGINE_LABEL: {{ .Values.TESTENGINE_LABEL }}
  PITCH_RTI_HOME: {{ .Values.PITCH_RTI_HOME }} 
  RTI_HOME: {{ .Values.RTI_HOME }} 
  #PITCH_ADVERTISE_TCP: "{{ .Values.PITCH_ADVERTISE_TCP }}"
  #PITCH_ADVERTISE_UDP: "{{ .Values.PITCH_ADVERTISE_UDP }}"
  #PITCH_ADVERTISE_ADDRESS: "{{ .Values.PITCH_ADVERTISE_ADDRESS }}"
  PITCH_CRCADDRESS: "{{ .Values.PITCH_CRCADDRESS }}"
  SETTINGS_DESIGNATOR: {{ .Values.SETTINGS_DESIGNATOR }}
  #LRC_CLASSPATH: {{ .Values.LRC_CLASSPATH }}
  CLASSPATH: {{ .Values.CLASSPATH }} 
  
  #TC_RUNNER_PI_SRVC_PORT: {{ .Values.TC_RUNNER_PI_SRVC_PORT }}
  #TC_RUNNER_PI_SRVC_PORT_6000: {{ .Values.TC_RUNNER_PI_SRVC_PORT_6000 }}
  #TC_RUNNER_PI_SRVC_PORT_5000: {{ .Values.TC_RUNNER_PI_SRVC_PORT_5000 }}
